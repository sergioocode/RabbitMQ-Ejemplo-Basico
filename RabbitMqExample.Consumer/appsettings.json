{
  // WeatherRpcWorker lee esta sección al arrancar la aplicación de consola.
  // Con estos datos abre la conexión que consumirá la cola "weather".
  "RabbitMQ": {
    // Consumer se ejecuta en Windows y utiliza el puerto publicado por Docker.
    "HostName": "localhost",

    // Puerto AMQP utilizado para enviar y recibir mensajes.
    // El puerto 15672 corresponde al panel web y no se usa desde el código.
    "Port": 5672,

    // Credenciales de desarrollo declaradas también en compose.yaml.
    "UserName": "guest",
    "Password": "guest",

    // Espacio lógico de RabbitMQ donde se crean exchanges, colas y bindings.
    "VirtualHost": "/"
  }
}
