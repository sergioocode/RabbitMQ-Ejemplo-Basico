{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // La Web API usa esta sección para conectarse al mismo broker
  // que la aplicación de consola Consumer.
  "RabbitMQ": {
    // La API se ejecuta en Windows y utiliza el puerto publicado por Docker.
    "HostName": "localhost",

    // Puerto AMQP. El panel de administración utiliza otro puerto: 15672.
    "Port": 5672,

    // Credenciales locales configuradas en compose.yaml.
    "UserName": "guest",
    "Password": "guest",

    // Ambos proyectos deben utilizar el mismo virtual host.
    "VirtualHost": "/"
  }
}
